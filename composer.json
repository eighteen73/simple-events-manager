{
	"name": "eighteen73/events",
	"description": "Add and display events on your WordPress site.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"autoload": {
		"psr-4": {
			"Eighteen73\\Events\\": "includes/classes/"
		}
	},
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"eighteen73/wordpress-coding-standards": "^2.0",
		"squizlabs/php_codesniffer": "^3.13"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"scripts": {
		"lint": "./vendor/bin/phpcs --standard=./phpcs.xml.dist",
		"format": "./vendor/bin/phpcbf --standard=./phpcs.xml.dist"
	}
}
