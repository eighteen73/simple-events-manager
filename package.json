{
	"name": "simple-events-manager",
	"description": "Add and display events on your WordPress site.",
	"main": "index.js",
	"scripts": {
		"postinstall": "composer install -o",
		"start": "wp-scripts start --webpack-copy-php --blocks-manifest",
		"build": "wp-scripts build  --webpack-copy-php --blocks-manifest",
		"check-engines": "wp-scripts check-engines",
		"check-licenses": "wp-scripts check-licenses",
		"format": "npm run format:css && npm run format:js && npm run format:php",
		"format:css": "stylelint --allow-empty-input --fix \"./src/**/*.{css,scss}\"",
		"format:js": "eslint --fix \"./src/**/*.js\"",
		"format:php": "composer run format",
		"lint": "npm run lint:css && npm run lint:js && npm run lint:php",
		"lint:css": "stylelint --allow-empty-input \"./src/**/*.{css,scss}\"",
		"lint:js": "wp-scripts lint-js",
		"lint:php": "composer run lint",
		"lint:md:docs": "wp-scripts lint-md-docs",
		"lint:pkg-json": "wp-scripts lint-pkg-json",
		"packages-update": "wp-scripts packages-update",
		"plugin-zip": "wp-scripts plugin-zip",
		"pot": "wp i18n make-pot . languages/simple-events-manager.pot --domain=simple-events-manager --exclude=node_modules,vendor,.git"
	},
	"author": "eighteen73 Web Team",
	"license": "GPL-2.0-or-later",
	"devDependencies": {
		"@eighteen73/eslint-config-wordpress": "latest",
		"@eighteen73/stylelint-config-wordpress": "latest",
		"@wordpress/browserslist-config": "latest",
		"@wordpress/prettier-config": "latest",
		"@wordpress/scripts": "latest",
		"fast-glob": "^3.3.3",
		"lefthook": "latest",
		"postcss-preset-env": "latest"
	},
	"dependencies": {
		"@fullcalendar/core": "^6.1.15",
		"@fullcalendar/daygrid": "^6.1.15",
		"@fullcalendar/react": "^6.1.15",
		"@humanmade/block-editor-components": "^0.10.0"
	}
}
